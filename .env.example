# Copy to .env and fill in. Never commit .env.
# The app refuses to start unless this is "sandbox".
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Public base URL used for PayPal return/cancel links (no trailing slash).
APP_BASE_URL=http://localhost:8000

# "live" calls the AI provider; "replay" uses the scripted demo (no key needed).
AI_MODE=replay
# "gemini" (default; free tier at aistudio.google.com) or "anthropic".
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Hard cap on AI calls per UTC day; after that the chat falls back to replay.
AI_DAILY_CALL_LIMIT=300

# SQLite file path.
DATABASE_PATH=open_counter.db
